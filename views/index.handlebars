
{{#each images}}
<article class="gallery-item" tabindex="0" onkeypress="if(event.key === 'Enter'){view(this.querySelector('img'), '{{this.id}}');}">
  <a>
    <img
      id="{{this.id}}"
      src="{{this.thumb}}"
      full="{{this.image}}"
      data-id="{{this.id}}"
      alt="{{this.name}}"
      title="{{this.description}}"
      loading="lazy"
      onmouseover="enhance(this)"
      onclick="view(this, '{{this.id}}')"
    />
  </a>
  <button class="shop-artwork" type="button" title="Shop this drawing" aria-label="Shop {{this.name}}">
    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path d="M3 4h2l2.1 11.1a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 1.9-1.4L21 8H6" />
      <circle cx="10" cy="20" r="1.2" />
      <circle cx="18" cy="20" r="1.2" />
    </svg>
  </button>
  <div class="reflection" style="background-image: url('{{this.thumb}}')"></div>
</article>
{{/each}}
<footer>
  This page is created and served using <a href="https://github.com/christopherdonner/imagebot">imageBot</a>
  All artwork and javascript seen here is the creation of Christopher Donner.
</footer>